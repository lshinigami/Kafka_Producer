SERVER_PORT=8081

PRODUCER_DB_URL=jdbc:postgresql://db-producer:5432/kafka-producer-db
PRODUCER_DB_NAME=kafka-producer-db
PRODUCER_DB_USERNAME=postgres
PRODUCER_DB_PASSWORD=admin
PRODUCER_DB_EXTERNAL_PORT=5435
PRODUCER_DB_INTERNAL_PORT=5432

CONSUMER_DB_URL=jdbc:postgresql://db-consumer:5432/kafka-consumer-db
CONSUMER_DB_NAME=kafka-consumer-db
CONSUMER_DB_USERNAME=postgres
CONSUMER_DB_PASSWORD=admin
CONSUMER_DB_EXTERNAL_PORT=5434
CONSUMER_DB_INTERNAL_PORT=5432

ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000

KAFKA_EXTERNAL_PORT=9093
KAFKA_INTERNAL_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092,PLAINTEXT_HOST://localhost:9093
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:9092,PLAINTEXT_HOST://0.0.0.0:9093
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_UI_PORT=8090
